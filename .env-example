POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bot_pravburo

# --- Разнесённое развёртывание: БД на сервере РФ, сервисы на сервере NL ---
# См. deploy/SPLIT_DEPLOYMENT.md

# Используется в docker-compose.db.yml НА СЕРВЕРЕ РФ:
# WireGuard-адрес самого этого сервера (wg0), НЕ публичный IP.
DB_BIND_ADDRESS=10.10.10.1

# Используется в docker-compose.yml НА СЕРВЕРЕ NL:
# WireGuard-адрес сервера БД (совпадает с DB_BIND_ADDRESS на сервере РФ).
DB_HOST=10.10.10.1
DB_PORT=5432
