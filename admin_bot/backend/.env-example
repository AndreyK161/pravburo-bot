DATABASE_URL=
BOT_TOKEN=
VK_TOKEN=
SESSION_SECRET_KEY=
SESSION_COOKIE_SECURE=false

# SSO с LK-хабом (PravBuroLK/services/admin_panel_service) — должно совпадать
# с JWT_SECRET из его .env, иначе подпись токена не сойдётся.
SSO_JWT_SECRET=
# Ссылка на LK-панель для переключалки в сайдбаре (необязательно, есть дефолт
# https://panel.prav-buro.ru — реальный адрес LK-хаба, без /admin-panel).
LK_ADMIN_URL=
