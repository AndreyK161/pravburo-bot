DATABASE_URL=
BOT_TOKEN=
VK_TOKEN=
SESSION_SECRET_KEY=
SESSION_COOKIE_SECURE=false

# SSO с LK-хабом (PravBuroLK/services/admin_panel_service) — должно совпадать
# с jwt_secret из его backend/.env, иначе подпись токена не сойдётся.
SSO_JWT_SECRET=
# Ссылка на LK-панель для переключалки в сайдбаре (необязательно, есть дефолт).
LK_ADMIN_URL=https://panel.prav-buro.ru/admin-panel
